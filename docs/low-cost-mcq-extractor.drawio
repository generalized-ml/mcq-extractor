  </diagram>
  <diagram id="ocr-architecture" name="02 — Local OCR architecture">
    <mxGraphModel dx="1500" dy="1680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;LOCAL OCR: DETECTOR + RECOGNIZER&lt;/b&gt;&lt;br&gt;ocr.py · native Transformers inference · FP32 default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;One question crop&lt;/b&gt;&lt;br&gt;RGB image; repeat for continuation parts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="135" width="570" height="75" as="geometry" />
        </mxCell>
        <mxCell id="preprocess" value="&lt;b&gt;Detector preprocessing&lt;/b&gt;&lt;br&gt;Resize, normalize, convert pixels to model dtype" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="255" width="570" height="75" as="geometry" />
        </mxCell>
        <mxCell id="det-backbone" value="&lt;b&gt;Detection backbone: PP-LCNetV3&lt;/b&gt;&lt;br&gt;Lightweight CNN · width scale 0.75&lt;br&gt;Features from stages 2, 3, 4, and 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="375" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="neck" value="&lt;b&gt;Multi-scale feature fusion&lt;/b&gt;&lt;br&gt;Residual squeeze-and-excitation layers&lt;br&gt;Upsample and concatenate features · 96 output channels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="515" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="head" value="&lt;b&gt;Segmentation head&lt;/b&gt;&lt;br&gt;Convolution + transposed convolution + sigmoid&lt;br&gt;Output: per-pixel text probability map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="655" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="polygons" value="&lt;b&gt;Text polygon extraction&lt;/b&gt;&lt;br&gt;Convert probability map to FP32 for OpenCV&lt;br&gt;Threshold, contours, box scores, polygon expansion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="795" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rectify" value="&lt;b&gt;Reading order + line rectification&lt;/b&gt;&lt;br&gt;Perspective crops; preserve aspect ratios&lt;br&gt;Group text lines into batches of 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="935" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rec-input" value="&lt;b&gt;Recognition preprocessing&lt;/b&gt;&lt;br&gt;Normalize each line independently&lt;br&gt;Pad to the widest line within its batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="135" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rec-backbone" value="&lt;b&gt;Recognition backbone: PP-LCNetV3&lt;/b&gt;&lt;br&gt;Lightweight CNN · width scale 0.95&lt;br&gt;Extract visual features from every text line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="275" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="svtr" value="&lt;b&gt;SVTR visual encoder&lt;/b&gt;&lt;br&gt;Convolution layers + 2 attention blocks&lt;br&gt;Hidden size 120 · 8 attention heads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="415" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="classify" value="&lt;b&gt;Character classification&lt;/b&gt;&lt;br&gt;Linear head: 18,385 output classes including CTC blank&lt;br&gt;Softmax gives character probabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="555" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="decode" value="&lt;b&gt;CTC decoding&lt;/b&gt;&lt;br&gt;Remove blank predictions and repeated symbols&lt;br&gt;Return line text and recognition confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="695" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="combine" value="&lt;b&gt;Combine in original line / part order&lt;/b&gt;&lt;br&gt;Text + boxes + scores + model identity + elapsed time&lt;br&gt;Parent parses MCQs and applies routing rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="835" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Execution and confidence notes&lt;/b&gt;&lt;br&gt;Each question worker owns both models and handles complete questions.&lt;br&gt;Models are loaded once; recognition batches run within the worker.&lt;br&gt;Confidence is an uncalibrated line score, not a correctness probability.&lt;br&gt;Text-only LLM review cannot recover visual evidence missing from OCR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="1175" width="1100" height="145" as="geometry" />
        </mxCell>

<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Low-Cost MCQ Extractor" version="24.7.17" type="device">
  <diagram id="pdf-pipeline" name="01 — PDF to MCQ pipeline">
    <mxGraphModel dx="1500" dy="1680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;LOW-COST MCQ EXTRACTOR&lt;/b&gt;&lt;br&gt;pdf_to_json_my · local OCR + selective text-only review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pdf" value="&lt;b&gt;Question-paper PDF&lt;/b&gt;&lt;br&gt;Source identity and SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="125" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="crops" value="&lt;b&gt;Prepare question crops · crops.py&lt;/b&gt;&lt;br&gt;Reuse a verified Docling crop run, or generate crops&lt;br&gt;Crop generation uses macOS Vision boundary checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="245" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Validate and resume · pipeline.py&lt;/b&gt;&lt;br&gt;Check PDF / code / model settings / artifact hashes&lt;br&gt;Skip completed questions; keep continuation parts together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="390" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Schedule whole questions · question_workers.py&lt;/b&gt;&lt;br&gt;P = min(X, max(1, floor(N physical cores / 2)))&lt;br&gt;Two CPU threads per worker; next free worker takes next question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="535" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="workers" value="&lt;b&gt;Persistent local OCR workers · ocr.py&lt;/b&gt;&lt;br&gt;Load pinned detector + recognizer once per worker&lt;br&gt;Text-line detection → rectification → recognition batches of 8&lt;br&gt;Full text, line polygons, line confidence, timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="695" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Local model cache&lt;/b&gt;&lt;br&gt;Parent resolves / downloads weights once&lt;br&gt;Workers read cached weights&lt;br&gt;FP32 default · PyTorch + Transformers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="695" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;Checkpoint and provenance&lt;/b&gt;&lt;br&gt;pipeline.json + runtime.json&lt;br&gt;Only parent writes artifacts&lt;br&gt;Per-question PID and OCR timing&lt;br&gt;Active wall-time sessions across resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="controls" value="&lt;b&gt;Bounded operation&lt;/b&gt;&lt;br&gt;--limit: new OCR questions&lt;br&gt;--workers: concurrent questions&lt;br&gt;--max-llm-questions: new reviews&lt;br&gt;--ocr-only: defer remote review&lt;br&gt;Single-core CPUs use one thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="535" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;Parent: parse + save drafts&lt;/b&gt;&lt;br&gt;structure.py → stem / 4 options / printed answer / solution&lt;br&gt;Save paddle_ocr.json, paddle_ocr.txt, mcq.json and mcqs.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="865" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="confidence" value="&lt;b&gt;Assess confidence and structure&lt;/b&gt;&lt;br&gt;confidence.py + route_question()&lt;br&gt;Through first Answer/Solution marker + 3 words (line granularity)&lt;br&gt;Score &amp;lt; 0.85, low-score fraction &amp;gt; 0.10, missing fields, or crop warnings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1010" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Review&lt;br&gt;required?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;shape=rhombus;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1170" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;Keep local extraction&lt;/b&gt;&lt;br&gt;No remote request for this question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1180" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;Selected text-only LLM review · review.py&lt;/b&gt;&lt;br&gt;Draft JSON + full OCR text → OpenRouter&lt;br&gt;Default: google/gemini-2.5-flash-lite&lt;br&gt;--ocr-only leaves review pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#a78bfa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1155" width="390" height="140" as="geometry" />
        </mxCell>
        <mxCell id="final" value="&lt;b&gt;Ordered final_mcqs.json&lt;/b&gt;&lt;br&gt;Source crop/page references + routing reasons + review status&lt;br&gt;Recorded API costs; uncertain OCR remains flagged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1350" width="600" height="105" as="geometry" />
        </mxCell>
        <mxCell id="golden" value="&lt;b&gt;Golden JSON folder&lt;/b&gt;&lt;br&gt;Match PDF identity and question ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1480" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;Optional evaluation · evaluation/&lt;/b&gt;&lt;br&gt;Keyword / semantic / aggregate scores&lt;br&gt;Recorded USD per PDF + coverage + runtimes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1500" width="600" height="95" as="geometry" />
        </mxCell>
        <mxCell id="csv" value="&lt;b&gt;results/experiment.csv → plot&lt;/b&gt;&lt;br&gt;One row per command · --no-save prints only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1640" width="600" height="80" as="geometry" />
        </mxCell>
